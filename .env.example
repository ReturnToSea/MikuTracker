# Copy to server/.env to override defaults (see server/src/config.ts for every setting).
# MIKU_DATA_DIR="/absolute/path"          # default: ~/Library/Application Support/MikuTracker
# DATABASE_URL="file:/absolute/path/miku.db"  # default: <data folder>/miku.db
# BACKUP_DIR="/absolute/path"             # default: <data folder>/backups
# THEME_ART_DIR="/absolute/path"          # default: <data folder>/theme-art
HOST=127.0.0.1                            # only this Mac; other addresses are refused until login exists
PORT=4750
# MIKU_BACKUPS=off                        # daily backups (on by default)
# MIKU_REFRESH=off                        # daily rankings refresh (on by default)
# MIKU_IN_CONTAINER=1                     # Docker only: allows HOST=0.0.0.0 (publish the port to 127.0.0.1)
