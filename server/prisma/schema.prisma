// The database: tables ("models") and their columns. Prisma writes the code that reads and
// writes them (into src/generated/, not in git) and the migrations that create them.
// Conventions: big numbers (EXP, raid power) are BigInt; "enum" fields are plain strings so the
// schema also works on Postgres later; every top-level table says whose data it is (ownerId,
// see src/owner.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One row per owner: what the app remembers between visits.
model Settings {
  ownerId   String   @id
  theme     String   @default("ren") // "ren" | "pochacco"
  worldId   Int      @default(45) // the world shown on Home: 45 Kronos, 70 Hyperion
  blackFlamePrice Int @default(3000000) // meso per Black Flame, for the Flames page's costs (v2.1.0)
  mvp             String @default("none") // the MVP tier, for its Star Force discount (v2.2.0): none | silver | gold | diamond
  updatedAt DateTime @updatedAt
}

// A character being tracked, with its latest looked-up details. One per name per world per owner.
model Character {
  id          Int        @id @default(autoincrement())
  ownerId     String
  worldId     Int // 45 Kronos, 70 Hyperion
  name        String // as Nexon spells it
  nameKey     String // the name in lowercase, for spotting duplicates
  job         String
  level       Int
  exp         BigInt // EXP into the current level
  worldRank   Int
  overallRank Int? // among all NA worlds; null if Nexon didn't list it
  legionLevel Int? // null: not the account's listed Legion character
  raidPower   BigInt?
  sortOrder   Int // position in the character tabs (0 first)
  addedAt      DateTime   @default(now())
  checkedAt    DateTime // last successful lookup
  missingSince DateTime? // when it stopped being found in the rankings (renamed, or dropped out); null while found
  avatarUrl    String? // Nexon's address of its current look, so the picture is only downloaded again when it changes
  snapshots   Snapshot[]
  avatars     Avatar[]
  selection   Selection?
  bossPlans   BossPlan[]
  bossClears  BossClear[]
  checklistPlans ChecklistPlan[]
  checklistTicks ChecklistTick[]
  symbols        SymbolState[]
  gear           GearSlot[]
  hexa           HexaPlan?
  statValues     StatValues?

  @@unique([ownerId, worldId, nameKey])
  @@index([ownerId, worldId, sortOrder])
}

// A character on one UTC day: the day's latest numbers (each refresh that day updates it in place).
// A day without one wasn't checked; a day whose numbers didn't change still has one (0 EXP gained).
model Snapshot {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  capturedAt  DateTime // when these numbers were last checked
  day         String // the UTC day, "YYYY-MM-DD"
  level       Int
  exp         BigInt
  totalExp    BigInt // everything since level 1, so gains work across level-ups
  gained      BigInt    @default(0) // EXP gained that day: each check adds the change since the check before
  worldRank   Int
  overallRank Int?
  legionLevel Int?
  raidPower   BigInt?

  @@unique([characterId, day])
}

// Each run of the refresh (every 4 hours): looking every character up in Nexon's rankings again.
model RefreshRun {
  id         Int       @id @default(autoincrement())
  startedAt  DateTime
  finishedAt DateTime? // null while running, or if the server stopped part way
  checked    Int       @default(0) // characters asked about
  updated    Int       @default(0) // found, and their details and today's snapshot saved
  missing    Int       @default(0) // not found in the rankings any more
  failed     Int       @default(0) // couldn't be checked (Nexon unreachable, odd answers, EXP not fitting the table)
  problem    String? // why the run stopped early, or the last failure
}

// Every avatar image a character has had (the file is named after its contents, in the data
// folder's avatars/). Kept for the avatar history planned after v1.0.0.
model Avatar {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  file        String
  firstSeenAt DateTime
  lastSeenAt  DateTime

  @@unique([characterId, file])
}

// Which character is selected on each world.
model Selection {
  ownerId     String
  worldId     Int
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([ownerId, worldId])
}

// A boss a character does: one row per boss, with the difficulty and party size it's done at.
// The plan stays the same week to week until it's changed. `boss` is an id from
// src/gameFigures/bosses.ts.
model BossPlan {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  boss        String
  difficulty  String // "Easy" | "Normal" | "Hard" | "Chaos" | "Extreme"
  partySize   Int

  @@unique([characterId, boss])
}

// A boss ticked as cleared, in one boss week (named by its first day, a Thursday: "2026-10-22") or,
// for a monthly boss, one month ("2026-11"). A new week simply has none yet, so nothing is cleared
// at the reset, and past weeks stay for a boss history later. The difficulty and party size are
// the plan's at the time (kept in step with the plan during the same week).
model BossClear {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  boss        String
  period      String
  difficulty  String
  partySize   Int
  clearedAt   DateTime

  @@unique([characterId, boss, period])
}

// One of the owner's own checklist tasks (the presets are in src/gameFigures/checklist.ts). Its
// task id is "custom-<id>". A weekly task resets on `weekday` (0 Sunday … 6 Saturday) at 00:00
// UTC; "none" is a one-off. A per-world or per-account limit lets `limitCount` characters do it
// each period.
model ChecklistTask {
  id         Int      @id @default(autoincrement())
  ownerId    String
  name       String
  category   String // "arcane" | "sacred" | "other"
  reset      String // "daily" | "weekly" | "none"
  weekday    Int?
  worlds     String // "both" | "45" | "70"
  limitScope String // "character" | "world" | "account"
  limitCount Int
  createdAt  DateTime @default(now())

  @@index([ownerId])
}

// A task a character does (a preset's id or "custom-<id>"). Kept until the plan changes.
model ChecklistPlan {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  task        String

  @@unique([characterId, task])
}

// A task ticked as done in one period: its UTC day ("2026-10-23") for a daily task, its week's
// first day for a weekly one, "once" for a one-off. A new period has none yet, so resets need
// nothing, and past periods are kept for a history later.
model ChecklistTick {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  task        String
  period      String
  doneAt      DateTime

  @@unique([characterId, task, period])
  @@index([task, period])
}

// One symbol of a character in the symbol calculator, saved as typed: its level (0: not
// unlocked), symbols held toward the next level, the days a week its daily is done, and its weekly
// clears (Arcane only). `symbol` is an id from src/gameFigures/symbols.ts.
model SymbolState {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  symbol      String
  level       Int
  held        Int
  days        Int
  weekly      Int

  @@unique([characterId, symbol])
}

// What a character has equipped in one slot of the gear tab's window ("hat", "ring1", "ringP" for
// the passive special skill ring, "totem2", …): a listed item (its key in
// src/gameFigures/gear-items.json: the id, or "<id>-<level>" for an Oz ring level), or an unlisted
// one by the name typed. An empty slot has no row.
model GearSlot {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  slot        String
  item        String? // a listed item's key
  other       String? // an unlisted item's name, as typed
  // v2.0.0: its stars, flames, potential and hammers, as JSON (shared/src/index.ts gearDetailsInput);
  // cleared whenever the item changes
  details     String?

  @@unique([characterId, slot])
}

// What each stat is worth to a character, in main stat, typed in (the gear tab; the defaults are the
// owner's: shared/src/index.ts STAT_VALUE_DEFAULTS). Used for flame scores and final damage from
// v2.1.0, potential lines from v2.3.0 (the new columns start at the defaults on saved rows). No row:
// the defaults.
model StatValues {
  characterId Int       @id
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  att         Float // 1 ATT = this much main stat
  allStat     Float // 1% all stat
  secRatio    Float // secondary stat ratio
  bossDmg     Float // 1% boss or damage
  fdPer100    Float // % final damage per 100 flame score
  strPct      Float? // 1% STR (null: the job's default, shared/src/index.ts STAT_PCT_DEFAULTS)
  dexPct      Float? // 1% DEX
  intPct      Float? // 1% INT
  lukPct      Float? // 1% LUK
  hpPct       Float? // 1% HP (Demon Avenger)
  attPct      Float   @default(53.82) // 1% ATT (mages: Magic ATT)
  critDmg     Float   @default(42.38) // 1% critical damage
  ied300      Float   @default(15.6) // 1% ignore defense against 300% boss defense
  ied380      Float   @default(20.52) // 1% ignore defense against 380% boss defense
  bossDef     Int     @default(380) // which of the two applies: 300 or 380
  // % final damage at 2 to 6 s of skill cooldown in all (v2.4.1; null: not typed, the nearest typed one
  // below counts; none: cooldown counts as nothing), and the seconds a hat must keep (0: none)
  cd2         Float?
  cd3         Float?
  cd4         Float?
  cd5         Float?
  cd6         Float?
  cdMin       Int     @default(0)
}

// A character's HEXA page (v3.0.0), as typed: `data` is the JSON of @miku/shared's HexaInput (each
// node's level now and wanted, the HEXA Stat nodes, the fragment calculator), checked on saving and on
// reading. No row: the defaults (HEXA_DEFAULTS).
model HexaPlan {
  characterId Int       @id
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  data        String
}
