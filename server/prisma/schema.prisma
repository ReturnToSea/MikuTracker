// The database: tables ("models") and their columns. Prisma writes the code that reads and
// writes them (into src/generated/, not in git) and the migrations that create them.
// Conventions: big numbers (EXP, raid power) are BigInt; "enum" fields are plain strings so the
// schema also works on Postgres later; every top-level table says whose data it is (ownerId,
// see src/owner.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One row per owner: what the app remembers between visits.
model Settings {
  ownerId   String   @id
  theme     String   @default("ren") // "ren" | "pochacco"
  worldId   Int      @default(45) // the world shown on Home: 45 Kronos, 70 Hyperion
  updatedAt DateTime @updatedAt
}

// A character being tracked, with its latest looked-up details. One per name per world per owner.
model Character {
  id          Int        @id @default(autoincrement())
  ownerId     String
  worldId     Int // 45 Kronos, 70 Hyperion
  name        String // as Nexon spells it
  nameKey     String // the name in lowercase, for spotting duplicates
  job         String
  level       Int
  exp         BigInt // EXP into the current level
  worldRank   Int
  overallRank Int? // among all NA worlds; null if Nexon didn't list it
  legionLevel Int? // null: not the account's listed Legion character
  raidPower   BigInt?
  sortOrder   Int // position in the character tabs (0 first)
  addedAt      DateTime   @default(now())
  checkedAt    DateTime // last successful lookup
  missingSince DateTime? // when it stopped being found in the rankings (renamed, or dropped out); null while found
  avatarUrl    String? // Nexon's address of its current look, so the picture is only downloaded again when it changes
  snapshots   Snapshot[]
  avatars     Avatar[]
  selection   Selection?

  @@unique([ownerId, worldId, nameKey])
  @@index([ownerId, worldId, sortOrder])
}

// A character on one UTC day: the day's latest numbers (each refresh that day updates it in place).
// A day without one wasn't checked; a day whose numbers didn't change still has one (0 EXP gained).
model Snapshot {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  capturedAt  DateTime // when these numbers were last checked
  day         String // the UTC day, "YYYY-MM-DD"
  level       Int
  exp         BigInt
  totalExp    BigInt // everything since level 1, so gains work across level-ups
  worldRank   Int
  overallRank Int?
  legionLevel Int?
  raidPower   BigInt?

  @@unique([characterId, day])
}

// Each run of the refresh (every 4 hours): looking every character up in Nexon's rankings again.
model RefreshRun {
  id         Int       @id @default(autoincrement())
  startedAt  DateTime
  finishedAt DateTime? // null while running, or if the server stopped part way
  checked    Int       @default(0) // characters asked about
  updated    Int       @default(0) // found, and their details and today's snapshot saved
  missing    Int       @default(0) // not found in the rankings any more
  failed     Int       @default(0) // couldn't be checked (Nexon unreachable, odd answers, EXP not fitting the table)
  problem    String? // why the run stopped early, or the last failure
}

// Every avatar image a character has had (the file is named after its contents, in the data
// folder's avatars/). Kept for the avatar history planned after v1.0.0.
model Avatar {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  file        String
  firstSeenAt DateTime
  lastSeenAt  DateTime

  @@unique([characterId, file])
}

// Which character is selected on each world.
model Selection {
  ownerId     String
  worldId     Int
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([ownerId, worldId])
}
