{
  "name": "mikutracker",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "qa": "node scripts/qa.mjs",
    "qa:check": "node scripts/qa-check.mjs",
    "backup": "npm run backup -w server",
    "app:install": "npm run app -w server -- install",
    "app:restart": "npm run app -w server -- restart",
    "app:rehearse": "npm run app -w server -- rehearse",
    "app:status": "npm run app -w server -- status",
    "app:uninstall": "npm run app -w server -- uninstall",
    "test": "npm test -w server && npm test -w client",
    "typecheck": "npm run typecheck -w server && tsc -p shared && npm run typecheck -w client",
    "db:migrate": "npm run db:migrate -w server",
    "test:coverage": "npm run test:coverage -w server",
    "test:utc": "npm run test:utc -w server",
    "test:mutate": "stryker run",
    "test:mutate:client": "stryker run stryker.client.config.mjs",
    "test:mutate:full": "stryker run --force && stryker run stryker.client.config.mjs --force",
    "nexon:check": "npm run nexon:check -w server --",
    "refresh": "npm run refresh -w server"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "concurrently": "^10.0.6",
    "playwright-core": "1.64.1"
  }
}
